DATABASE_URL = "driver://user:pass@localhost/dbname"
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
TIME_ZONE=-4
ENABLE_ACCESS_AUDIT=False
ENABLE_DATA_AUDIT=True
AUDIT_EXCLUDED_PATHS='["/docs", "/redoc", "/openapi.json", "GET:/health", "/", "/api/catalogs"]'
AUDIT_LOG_EXCLUDE_STATUS_CODES='[404]'
# Use this to filter out GET requests to save space
AUDIT_LOG_INCLUDED_METHODS='["POST", "PUT", "PATCH", "DELETE"]'
ENVIRONMENT=production
ENABLE_ACCESS_LOGS=True
ACCESS_LOGS_ONLY_ERRORS=True
BACKEND_CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200", "http://localhost:8000"]

# Security Lockout
SECURITY_LOGIN_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SYNC_DATABASE_URL="driver://user:pass@localhost/an_core"

# Cloudinary Media Storage (Avatares y Fotos de Productos)
CLOUDINARY_CLOUD_NAME=novalabs-bo
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Commercial Assistant (Multi-Provider: Groq, Mistral, Gemini)
AI_DEFAULT_PROVIDER=groq
AI_ENABLE_FALLBACK=True

# Groq (console.groq.com - ultra rápido y gratuito)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Mistral AI (console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=ministral-8b-latest

# Google Gemini (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
